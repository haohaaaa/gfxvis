{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "src/**/*.js",
      "src/**/*.jsx",
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.astro",
      "e2e/**/*.ts",
      "scripts/**/*.ts",
      "astro.config.ts",
      "playwright.config.ts",
      "package.json",
      "biome.json",
      "tsconfig.json",
      "skills-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "bracketSpacing": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "linter": {
      "enabled": false
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off"
      },
      "a11y": {
        "preset": "none"
      },
      "complexity": {
        "preset": "none"
      },
      "performance": {
        "preset": "none"
      },
      "security": {
        "preset": "none",
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "preset": "none",
        "noArrayIndexKey": "off",
        "noDeprecatedImports": "warn",
        "noExplicitAny": "error"
      },
      "style": {
        "preset": "none"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "a11y": {
            "preset": "recommended",
            "useAnchorContent": "off"
          }
        }
      }
    }
  ]
}

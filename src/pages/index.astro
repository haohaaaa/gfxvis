---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/content/PostCard.astro";
import { getCollection } from "astro:content";

export const prerender = true;

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout showSidebar>
  <div class="kde-breeze-ui kde-home">
    <section
      class="kde-site-window kde-home__welcome"
      aria-labelledby="home-title"
    >
      <header class="kde-site-window__titlebar">
        <span class="kde-site-window__mark" aria-hidden="true"> G </span>
        <div class="kde-site-window__heading">
          <span class="kde-site-window__eyebrow">
            BREEZE WORKSPACE · KNOWLEDGE BASE
          </span>
          <span class="kde-site-window__title">图形学与可视化</span>
        </div>
        <span class="kde-site-window__mode">HOME</span>
      </header>
      <div class="kde-site-window__body kde-home__welcome-body">
        <h1 id="home-title" class="kde-home__brand">GFX<span>Vis</span></h1>
        <p class="kde-home__description">
          图形学与可视化技术博客：渲染、光照、Vulkan、WebGPU 与 3D 交互示例。
        </p>
        <a class="kde-home__browse-link" href="/posts">
          浏览全部文章
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section
      class="kde-site-window kde-home__articles"
      aria-labelledby="latest-posts-title"
    >
      <header class="kde-site-window__titlebar">
        <span class="kde-site-window__mark" aria-hidden="true"> A </span>
        <div class="kde-site-window__heading">
          <span class="kde-site-window__eyebrow">ARTICLE LIBRARY</span>
          <h2 id="latest-posts-title" class="kde-site-window__title">
            最新文章
          </h2>
        </div>
        <span class="kde-site-window__mode">{posts.length} POSTS</span>
      </header>
      <div class="kde-site-window__body kde-home__articles-body">
        <div class="kde-home__post-list">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.kde-home {
  display: grid;
  gap: 1rem;
  min-width: 0;
  color: var(--kde-ink);
  font-family: "Noto Sans", "Oxygen", system-ui, -apple-system, sans-serif;
}

.kde-home__welcome-body {
  padding: 1.4rem 1.5rem 1.5rem;
  background:
    radial-gradient(
      circle at 92% 10%,
      color-mix(in srgb, var(--kde-accent) 15%, transparent),
      transparent 15rem
    ),
    var(--kde-panel);
}

.kde-home__brand {
  margin: 0;
  color: var(--kde-ink);
  font-size: clamp(2.1rem, 5vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.055em;
  line-height: 1.1;
}

.kde-home__brand span {
  color: var(--kde-accent);
}

.kde-home__description {
  max-width: 42rem;
  margin: 0.7rem 0 0;
  color: var(--kde-muted);
  font-size: 0.9rem;
  line-height: 1.7;
}

.kde-home__browse-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  margin-top: 1.1rem;
  border: 1px solid color-mix(in srgb, var(--kde-accent) 55%, var(--kde-border));
  border-radius: var(--kde-control-radius);
  background: color-mix(in srgb, var(--kde-accent) 15%, var(--kde-raised));
  padding: 0.45rem 0.7rem;
  color: var(--kde-ink);
  font-size: 0.76rem;
  font-weight: 650;
  text-decoration: none;
  transition:
    border-color 150ms ease,
    color 150ms ease,
    background-color 150ms ease;
}

.kde-home__browse-link:hover,
.kde-home__browse-link:focus-visible {
  border-color: var(--kde-accent);
  background: var(--kde-accent);
  color: var(--kde-accent-ink);
}

.kde-home__browse-link:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--kde-accent) 65%, transparent);
  outline-offset: 2px;
}

.kde-home__articles-body {
  background: var(--kde-panel);
}

.kde-home__post-list {
  display: grid;
  gap: 0.65rem;
}

.kde-home__post-list :global(article) {
  border-color: var(--kde-border);
  border-radius: var(--kde-card-radius);
  background: var(--kde-raised);
  padding: 1rem 1.1rem;
  box-shadow: 0 1px 2px rgb(15 23 42 / 0.06);
  transition:
    border-color 150ms ease,
    box-shadow 150ms ease,
    transform 150ms ease;
}

.kde-home__post-list :global(article:hover) {
  border-color: var(--kde-accent);
  box-shadow: 0 3px 10px rgb(15 23 42 / 0.08);
  transform: translateY(-1px);
}

.kde-home__post-list :global(article h3) {
  color: var(--kde-ink);
  font-size: 1rem;
  line-height: 1.5;
}

.kde-home__post-list :global(article a:hover h3) {
  color: var(--kde-accent);
}

.kde-home__post-list :global(article p) {
  margin-top: 0.45rem;
  color: var(--kde-muted);
  font-size: 0.76rem;
  line-height: 1.65;
}

.kde-home__post-list :global(article time) {
  color: var(--kde-muted);
  font-family: ui-monospace, monospace;
  font-size: 0.65rem;
}

.kde-home__post-list :global(article time + span > span) {
  border-color: var(--kde-border);
  border-radius: 0.28rem;
  background: var(--kde-panel);
  padding: 0.14rem 0.4rem;
  color: var(--kde-muted);
  font-size: 0.62rem;
}

.kde-home__post-list :global(article a:focus-visible) {
  border-radius: var(--kde-card-radius);
  outline: 2px solid color-mix(in srgb, var(--kde-accent) 65%, transparent);
  outline-offset: 3px;
}

@media (max-width: 639px) {
  .kde-home__welcome-body {
    padding: 1.1rem 1rem 1.2rem;
  }

  .kde-home__description {
    font-size: 0.82rem;
  }

  .kde-home__articles-body {
    padding: 0.65rem;
  }

  .kde-home__post-list :global(article) {
    padding: 0.85rem;
  }
}
</style>

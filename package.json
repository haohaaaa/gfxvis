{
  "name": "gfxvis",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate && astro build",
    "preview": "astro preview",
    "export:single": "tsx scripts/export-single-html.ts",
    "astro": "astro",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "check:headings": "tsx scripts/check-headings.ts",
    "format:bold": "tsx scripts/format-bold.ts",
    "format:bold:check": "tsx scripts/format-bold.ts --check",
    "format": "tsx scripts/format-bold.ts && biome format --write . && prettier --write \"**/*.md\" \"**/*.mdx\" \"**/*.css\" \"**/*.yaml\" \"**/*.yml\"",
    "format:check": "biome format . && prettier --check \"**/*.md\" \"**/*.mdx\" \"**/*.css\" \"**/*.yaml\" \"**/*.yml\" && tsx scripts/format-bold.ts --check",
    "validate": "pnpm typecheck && pnpm lint && pnpm check:headings && pnpm format:check",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "test:screenshots": "pnpm build && SCREENSHOT=1 playwright test",
    "test:screenshots:ui": "pnpm build && SCREENSHOT=1 playwright test --ui"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/three": "^0.187.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3"
  }
}
